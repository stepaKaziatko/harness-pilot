# Development defaults. Copy to .env to override; .env is git-ignored.
# These are local throwaway credentials for the docker compose database, not secrets.
POSTGRES_USER=pilot
POSTGRES_PASSWORD=pilot
POSTGRES_DB=pilot
# Host port of the compose Postgres service. Change it if 5432 is taken.
POSTGRES_PORT=5432
# Must match the three values above.
DATABASE_URL=postgres://pilot:pilot@localhost:5432/pilot
API_PORT=3001
WEB_PORT=5173
